rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down everything by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Explicitly allow users to read/write ONLY their own document
    // `request.auth.uid` is securely provided by Firebase Auth
    // The document ID in the 'users' collection must exactly match their Auth UID.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
